{% extends 'base.html.twig' %}
{% block title %}Inicio - Mi primera App{% endblock %}

{% block body %}
  <div class="container welcome-page">
    <section class="welcome-section">
      <h1>Bienvenido a mi primera aplicación <span class="accent-text">Symfony</span></h1>
      <p><strong>Desarrollador: </strong>{{ nombre_alumno }}</p>
      <p><strong>Sobre el proyecto: </strong>{{ descripcion_proyecto }}</p>
    </section>

    <section class="petition">
      <small>Petición procesada de forma dinámica el: {{ fecha_actual }}</small>
    </section>
  </div>
{% endblock %}